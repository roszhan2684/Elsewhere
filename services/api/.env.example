# Live Meta calls happen ONLY when all three are set: MODEL_MODE=live, a key, and BUDGET_USD > 0.
MODEL_MODE=mock
MODEL_API_KEY=
# Hard cap in USD for THIS environment (Meta has no hard cap of its own, only an email alert).
# Keep laptop + production caps together well under your free credits, e.g. 40 + 70 of 150.
BUDGET_USD=0
BUDGET_SAFETY_FACTOR=1.15
# Local default is SQLite. In production use Supabase Postgres:
# DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres
CORS_ORIGINS=http://localhost:3000
DEMO_LIVE_CALLS_PER_HOUR=30
